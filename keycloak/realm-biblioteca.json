{
  "realm": "biblioteca",
  "displayName": "Biblioteca",
  "enabled": true,

  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "editUsernameAllowed": false,

  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR", "en"],
  "defaultLocale": "pt-BR",

  "sslRequired": "all",

  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "passwordPolicy": "length(12) and notUsername(undefined) and passwordHistory(3)",

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "quickLoginCheckMilliSeconds": 0,

  "loginTheme": "biblioteca",

  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "biblioteca@biblioteca.dev",
    "fromDisplayName": "Biblioteca",
    "ssl": "false",
    "starttls": "false",
    "auth": "false",
    "envelopeFrom": ""
  },

  "roles": {
    "realm": [
      {
        "name": "leitor",
        "description": "Reserva Livros on-line e acompanha as próprias Reservas e Empréstimos (RN-7).",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "bibliotecario",
        "description": "Efetiva Empréstimo e registra Devolução no balcão (RN-2, RN-7).",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "default-roles-biblioteca",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": ["leitor"],
          "client": {
            "account": ["manage-account", "view-profile"]
          }
        },
        "clientRole": false
      }
    ]
  },

  "defaultRole": {
    "name": "default-roles-biblioteca",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false
  },

  "clients": [
    {
      "clientId": "biblioteca-web",
      "name": "Biblioteca — SPA",
      "description": "SPA React. Authorization Code + PKCE. Sem Direct Access Grant (Fase 2): token só via navegador, com tela e PKCE (docs/seguranca.md).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience-biblioteca-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "biblioteca-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "biblioteca-e2e",
      "name": "Biblioteca — Testes e Carga (Playwright/K6)",
      "description": "Direct Access Grant para Playwright e K6 obterem token sem navegador. Restrito a localhost; em produção este client NÃO deve existir no realm (docs/seguranca.md §5).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "protocolMappers": [
        {
          "name": "audience-biblioteca-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "biblioteca-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],

