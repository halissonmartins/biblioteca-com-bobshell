DATABASE_URL=postgresql://biblioteca:biblioteca@localhost:5432/biblioteca
DATABASE_URL_TEST=postgresql://biblioteca:biblioteca@localhost:5432/biblioteca_test
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
JWT_REFRESH_SECRET=troque-por-outra-string-longa-e-aleatoria
PORT=3000

# Opcional e usado só por `make capas` (ADR-0008): sem chave, a API JSON do
# Google Books concede ~100 consultas por dia por IP e costuma responder 429.
# A URL direta por ISBN, que é a fonte primária, não depende disto.
GOOGLE_BOOKS_API_KEY=
NODE_ENV=development

# ── Observabilidade (OpenTelemetry) — ver docs/observabilidade.md ────────────
# Endpoint OTLP do Collector. Se ele não estiver no ar, o export falha em
# silêncio e a API segue funcionando normalmente. Suba com: make obs-up
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=biblioteca-api
OTEL_SERVICE_VERSION=0.0.0
# true desliga o SDK inteiro (já é desligado sozinho quando NODE_ENV=test)
OTEL_SDK_DISABLED=false
# Intervalo de export das métricas, em ms
OTEL_METRIC_EXPORT_INTERVAL=15000
# Emite a semântica HTTP estável (http.server.request.duration em segundos).
# Sem isto o nome e a unidade da métrica mudam e os dashboards ficam vazios.
OTEL_SEMCONV_STABILITY_OPT_IN=http
# true liga o log de diagnóstico do próprio SDK — a resposta para
# "liguei tudo e não chega nada no Collector"
OTEL_DIAG=false

# ── Logs ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Gauges de estado (consultam o banco a cada coleta) ───────────────────────
BUSINESS_GAUGES_ENABLED=true
BUSINESS_GAUGES_TTL_MS=60000
