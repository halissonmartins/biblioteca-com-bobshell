DATABASE_URL=postgresql://biblioteca:biblioteca@localhost:5432/biblioteca
DATABASE_URL_TEST=postgresql://biblioteca:biblioteca@localhost:5432/biblioteca_test
PORT=3000

# ── Identidade (Keycloak) — ver docs/seguranca.md e ADR-0009 ─────────────────
# Não há segredo de assinatura aqui: a API é resource server e valida o token
# contra o JWKS público do realm. Se o Keycloak não estiver no ar, toda rota
# autenticada responde 401 — suba com `make db-up` (que gera os certs antes).
# Fase 2: https obrigatório (sslRequired: all). O issuer precisa bater EXATA-
# MENTE com KC_HOSTNAME do compose — barra final e esquema contam.
KEYCLOAK_ISSUER_URL=https://localhost:8443/realms/biblioteca
# Precisa bater com o mapper `audience-biblioteca-api` do realm; se divergir, a
# API rejeita todo token com TOKEN_INVALID.
KEYCLOAK_AUDIENCE=biblioteca-api

# CA local gerada por `make certs` (scripts/gerar-certificados.sh): sem ela o Node
# recusa o certificado do Keycloak ao buscar o JWKS. NODE_EXTRA_CA_CERTS NÃO vive
# aqui — tem de estar no ambiente antes de o processo subir, e dotenv chega tarde:
#   - a API a recebe do script `dev` de packages/api (cross-env);
#   - as suítes E2E a declaram na própria playwright.config.ts, com caminho absoluto.
# Este arquivo é copiado para os três .env, e o Prisma Client carrega o de
# packages/api dentro dos processos do E2E: um caminho relativo posto aqui vazava
# para fora do repositório e escondia TLS desligado nos workers (issue #34).
# Quem tem .env antigo apaga a linha à mão — `make env` não sobrescreve.

# ── Credenciais do Keycloak (lidas pelo docker compose no .env da RAIZ) ──────
# Fase 2: nada de admin/admin versionado. O compose interpola estes valores;
# troque-os no seu .env local antes do primeiro `docker compose up -d`.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha-no-seu-env
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# Lidas pelo Vite no build da SPA (prefixo VITE_ é obrigatório para chegar ao
# browser). A SPA fala com o Keycloak direto, sem passar pela API.
VITE_KEYCLOAK_URL=https://localhost:8443
VITE_KEYCLOAK_REALM=biblioteca
VITE_KEYCLOAK_CLIENT_ID=biblioteca-web

# Opcional e usado só por `make capas` (ADR-0008): sem chave, a API JSON do
# Google Books concede ~100 consultas por dia por IP e costuma responder 429.
# A URL direta por ISBN, que é a fonte primária, não depende disto.
GOOGLE_BOOKS_API_KEY=
NODE_ENV=development

# ── Observabilidade (OpenTelemetry) — ver docs/observabilidade.md ────────────
# Endpoint OTLP do Collector. Se ele não estiver no ar, o export falha em
# silêncio e a API segue funcionando normalmente. Suba com: make obs-up
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=biblioteca-api
OTEL_SERVICE_VERSION=0.0.0
# true desliga o SDK inteiro (já é desligado sozinho quando NODE_ENV=test)
OTEL_SDK_DISABLED=false
# Intervalo de export das métricas, em ms
OTEL_METRIC_EXPORT_INTERVAL=15000
# Emite a semântica HTTP estável (http.server.request.duration em segundos).
# Sem isto o nome e a unidade da métrica mudam e os dashboards ficam vazios.
OTEL_SEMCONV_STABILITY_OPT_IN=http
# true liga o log de diagnóstico do próprio SDK — a resposta para
# "liguei tudo e não chega nada no Collector"
OTEL_DIAG=false

# ── Logs ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Gauges de estado (consultam o banco a cada coleta) ───────────────────────
BUSINESS_GAUGES_ENABLED=true
BUSINESS_GAUGES_TTL_MS=60000
